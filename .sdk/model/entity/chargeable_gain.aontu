# Entity: chargeable_gain

main: kit: entity: chargeable_gain: {

  alias: field: {}

  fields: {
    acquisition_cost: {
      h: "Acquisition Cost"
      n: "acquisition_cost"
      r: true
      sh: "What the company paid for the asset, in pounds."
      t: "`$NUMBER`"
    }
    acquisition_costs: {
      h: "Acquisition Costs"
      n: "acquisition_costs"
      r: false
      sh: "Optional."
      t: "`$NUMBER`"
    }
    acquisition_date: {
      fo: "date"
      h: "Acquisition Date"
      n: "acquisition_date"
      r: true
      sh: "When the company bought the asset (exchange of contracts), as YYYY-MM-DD."
      t: "`$STRING`"
    }
    asset_type: {
      h: "Asset Type"
      n: "asset_type"
      r: true
      sh: "\"land_buildings\": UK land or buildings (the company's whole interest; a freehold or a lease with more than 50 years left)."
      t: "`$STRING`"
    }
    calculated_by: {
      h: "Calculated By"
      n: "calculated_by"
      r: true
      t: "`$STRING`"
    }
