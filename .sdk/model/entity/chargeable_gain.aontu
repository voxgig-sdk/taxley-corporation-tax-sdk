      t: "`$STRING`"
    }
    disposal_costs: {
      h: "Disposal Costs"
      n: "disposal_costs"
      r: false
      sh: "Optional."
      t: "`$NUMBER`"
    }
    disposal_date: {
      fo: "date"
      h: "Disposal Date"
      n: "disposal_date"
      r: true
      sh: "When the company sold the asset (exchange of contracts), as YYYY-MM-DD."
      t: "`$STRING`"
    }
    enhancement_cost: {
      h: "Enhancement Cost"
      n: "enhancement_cost"
      r: false
      sh: "Optional, land and buildings only."
      t: "`$NUMBER`"
    }
    enhancement_date: {
      fo: "date"
      h: "Enhancement Date"
      n: "enhancement_date"
      r: false
      sh: "Optional, land and buildings only."
      t: "`$STRING`"
    }
    input: {
      h: "Input"
      n: "input"
      r: true
      sh: "The input as the tool read it (dates YYYY-MM-DD, money in pounds)."
      t: "`$OBJECT`"
    }
    page_url: {
      fo: "uri"
      h: "Page Url"
      n: "page_url"
      r: true
      t: "`$STRING`"
    }
    proceeds: {
      h: "Proceeds"
      n: "proceeds"
      r: true
      sh: "What the company sold the asset for, in pounds."
      t: "`$NUMBER`"
    }
    result: {
      h: "Result"
      n: "result"
      r: true
      t: "`$OBJECT`"
    }
    sba_claimed: {
      h: "Sba Claimed"
      n: "sba_claimed"
      r: false
      sh: "Optional, land and buildings only."
      t: "`$NUMBER`"
    }
    share_url: {
      fo: "uri"
      h: "Share Url"
      n: "share_url"
      r: true
      sh: "A link to this result on taxley.co.uk."
      t: "`$STRING`"
    }
    tool: {
      h: "Tool"
      n: "tool"
      r: true
      t: "`$STRING`"
    }
  }

  name: "chargeable_gain"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "acquisition_cost"
            "acquisition_costs"
            "acquisition_date"
            "asset_type"
            "disposal_costs"
            "disposal_date"
