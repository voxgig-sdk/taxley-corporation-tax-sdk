# Entity: deadline

main: kit: entity: deadline: {

  alias: field: {}

  fields: {
    calculated_by: {
      h: "Calculated By"
      n: "calculated_by"
      r: true
      t: "`$STRING`"
    }
    disclaimer: {
      h: "Disclaimer"
      n: "disclaimer"
      r: true
      t: "`$STRING`"
    }
    input: {
      h: "Input"
      n: "input"
      r: true
      sh: "The input as the tool read it (dates YYYY-MM-DD, money in pounds)."
      t: "`$OBJECT`"
    }
    page_url: {
      fo: "uri"
      h: "Page Url"
      n: "page_url"
      r: true
      t: "`$STRING`"
    }
    period_end: {
      fo: "date"
      h: "Period End"
      n: "period_end"
      r: true
      sh: "The last day of the accounts period (the company's year end or accounting reference date), as YYYY-MM-DD."
      t: "`$STRING`"
    }
    period_start: {
      fo: "date"
      h: "Period Start"
      n: "period_start"
      r: false
      sh: "Optional."
      t: "`$STRING`"
    }
    result: {
      h: "Result"
      n: "result"
      r: true
      t: "`$OBJECT`"
    }
    share_url: {
      fo: "uri"
      h: "Share Url"
      n: "share_url"
      r: true
      sh: "A link to this result on taxley.co.uk."
      t: "`$STRING`"
    }
    tool: {
      h: "Tool"
      n: "tool"
      r: true
      t: "`$STRING`"
    }
  }

  name: "deadline"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "period_end"
            "period_start"
          ]
          co: {
            id: "POST /api/v1/tools/deadlines"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/tools/deadlines"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "tools"
            }
            {
              lit: "deadlines"
            }
          ]
          t: {
            req: {
              period_end: "`reqdata.period_end`"
              period_start: "`reqdata.period_start`"
            }
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/v1/tools/deadlines"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "2026-03-31"
                k: "query"
                n: "period_end"
                or: "period_end"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "period_start"
                or: "period_start"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/tools/deadlines"
          q: {
            exist: [
              "period_end"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "tools"
            }
            {
              lit: "deadlines"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
