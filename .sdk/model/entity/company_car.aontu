              }
              {
                k: "query"
                n: "electric_range_mile"
                or: "electric_range_miles"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "electric"
                k: "query"
                n: "fuel_type"
                or: "fuel_type"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "basic"
                k: "query"
