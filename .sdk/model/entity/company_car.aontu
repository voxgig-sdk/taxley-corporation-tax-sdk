              price_paid: "`reqdata.price_paid`"
              private_fuel: "`reqdata.private_fuel`"
              tax_year: "`reqdata.tax_year`"
            }
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/v1/tools/company-car"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "acquisition"
                or: "acquisition"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "annual_lease_cost"
                or: "annual_lease_cost"
                r: false
                t: "`$NUMBER`"
              }
              {
                k: "query"
                n: "associated_company"
                or: "associated_companies"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
