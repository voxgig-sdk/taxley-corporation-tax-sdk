# Entity: company_car

main: kit: entity: company_car: {

  alias: field: {}

  fields: {
    acquisition: {
      h: "Acquisition"
      n: "acquisition"
      r: false
      sh: "Optional."
      t: "`$STRING`"
    }
    annual_lease_cost: {
      h: "Annual Lease Cost"
      n: "annual_lease_cost"
      r: false
      sh: "For \"lease\": the lease rentals the company pays in its year, in pounds, excluding VAT it can reclaim."
      t: "`$NUMBER`"
    }
    associated_companies: {
      h: "Associated Companies"
      n: "associated_companies"
      r: false
      sh: "Optional, with company_profits."
      t: "`$INTEGER`"
    }
    calculated_by: {
      h: "Calculated By"
      n: "calculated_by"
      r: true
      t: "`$STRING`"
    }
    capital_contribution: {
      h: "Capital Contribution"
      n: "capital_contribution"
      r: false
      sh: "Optional."
      t: "`$NUMBER`"
    }
    co2_gkm: {
      h: "Co2 Gkm"
      n: "co2_gkm"
      r: false
      sh: "The car's approved CO2 emissions in g/km, from the V5C or certificate of conformity (WLTP for cars first registered from 6 April 2020, NEDC before; both give the same percentage in 2025/26 and 2026/27)."
      t: "`$INTEGER`"
    }
    company_profits: {
      h: "Company Profits"
      n: "company_profits"
      r: false
      sh: "Optional."
      t: "`$NUMBER`"
    }
    disclaimer: {
      h: "Disclaimer"
      n: "disclaimer"
      r: true
      t: "`$STRING`"
    }
    electric_range_miles: {
      h: "Electric Range Miles"
      n: "electric_range_miles"
      r: false
      sh: "For a plug-in hybrid only: the zero-emission (electric) range in miles from the certificate of conformity, rounded up."
      t: "`$INTEGER`"
    }
    fuel_type: {
      h: "Fuel Type"
      n: "fuel_type"
      r: true
      sh: "\"electric\" (fully electric or any car with 0 g/km CO2), \"petrol\" (petrol, or ANY hybrid, petrol or diesel, including plug-in hybrids: hybrids never pay the diesel supplement), \"diesel_rde2\" (a diesel-only car certified to Euro 6d, also…"
      t: "`$STRING`"
    }
    income_tax_rate: {
      h: "Income Tax Rate"
      n: "income_tax_rate"
      r: true
      sh: "The director's top rate of Income Tax including the benefit: \"basic\" (20%), \"higher\" (40%) or \"additional\" (45%)."
      t: "`$STRING`"
    }
    input: {
      h: "Input"
      n: "input"
      r: true
      sh: "The input as the tool read it (dates YYYY-MM-DD, money in pounds)."
      t: "`$OBJECT`"
    }
    lease_started: {
      fo: "date"
      h: "Lease Started"
      n: "lease_started"
      r: false
      sh: "Optional, for \"lease\": the date the hire period began, YYYY-MM-DD."
      t: "`$STRING`"
    }
    list_price: {
      h: "List Price"
      n: "list_price"
      r: true
      sh: "The car's list price when new, including VAT, delivery and any optional extras (the P11D price), in pounds."
      t: "`$NUMBER`"
    }
    months_available: {
      h: "Months Available"
      n: "months_available"
      r: false
      sh: "Optional."
      t: "`$INTEGER`"
    }
    new_car: {
      h: "New Car"
      n: "new_car"
      r: false
      sh: "Optional, for \"buy\"."
      t: "`$BOOLEAN`"
    }
    page_url: {
      fo: "uri"
      h: "Page Url"
      n: "page_url"
      r: true
      t: "`$STRING`"
    }
    phev_easement: {
      h: "Phev Easement"
      n: "phev_easement"
      r: false
      sh: "Optional."
      t: "`$BOOLEAN`"
    }
    price_paid: {
      h: "Price Paid"
      n: "price_paid"
      r: false
      sh: "Optional, for \"buy\"."
      t: "`$NUMBER`"
    }
    private_fuel: {
      h: "Private Fuel"
      n: "private_fuel"
      r: false
      sh: "Optional."
      t: "`$BOOLEAN`"
    }
    result: {
      h: "Result"
      n: "result"
      r: true
      t: "`$OBJECT`"
    }
    share_url: {
      fo: "uri"
      h: "Share Url"
      n: "share_url"
      r: true
      sh: "A link to this result on taxley.co.uk."
      t: "`$STRING`"
    }
    tax_year: {
      h: "Tax Year"
      n: "tax_year"
      r: true
      sh: "UK tax year: \"2025-26\" (6 April 2025 to 5 April 2026) or \"2026-27\" (6 April 2026 to 5 April 2027)."
      t: "`$STRING`"
    }
    tool: {
      h: "Tool"
      n: "tool"
      r: true
      t: "`$STRING`"
    }
  }

  name: "company_car"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "acquisition"
            "annual_lease_cost"
            "associated_companies"
            "capital_contribution"
            "co2_gkm"
            "company_profits"
            "electric_range_miles"
